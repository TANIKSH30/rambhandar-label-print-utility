{
  "name": "rambhandar-label-print-utility",
  "productName": "Label Print Utility",
  "version": "1.0.0",
  "description": "Industrial Thermal Label Printing Desktop Application for Matadin Ram Bhandar",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json && vite build --config vite.config.electron.ts",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"npm:electron:start\"",
    "electron:start": "wait-on tcp:5173 && electron .",
    "electron:build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run electron:build && electron-builder --win dir"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "bwip-js": "^4.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.matadinrambhandar.labelprinter",
    "productName": "Label Print Utility",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "dir",
      "forceCodeSigning": false
    }
  }
}
